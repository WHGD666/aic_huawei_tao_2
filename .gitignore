# ---- secrets ----
workspace/.env
*.key

# ---- environments / third-party (never commit) ----
env/
third_party/

# ---- run artifacts (large / regenerable). Final submission copies are curated manually ----
workspace/logs/*
!workspace/logs/.gitkeep
# 彩排样例入库（提交材料 logs/ 结构的真实样本，~数 MB）；work/ 工作副本不要
!workspace/logs/rehearsal/
workspace/logs/rehearsal/**/work/
workspace/results/**
!workspace/results/.gitkeep
workspace/candidates/**
!workspace/candidates/.gitkeep
workspace/baseline/**
!workspace/baseline/.gitkeep

# ---- python ----
__pycache__/
*.pyc
.pytest_cache/

# ---- misc ----
*.vhdx
*.tar
*.log
.DS_Store
Thumbs.db
workspace/algorithms/

# ---- 官方大文件（7 GB 镜像 / 数据包）：只放 F 盘，不入库 ----
2/
*.tar.gz
*.pyc
*.pdf

# Curated submission artifact and local report previews stay outside Git.
AIC-2026-18059446_赛题2_初赛/
AIC-2026-18059446_赛题2.zip*
tools/report-preview-*.png
tools/*.aux
tools/*.out
