diff --git a/loss.py b/loss.py
--- a/loss.py
+++ b/loss.py
@@ -49,4 +49,27 @@ def compute_loss(p, graph, feats):
     # ---- 二值化：p 远离 0.5 ----
     l_bin = (p * (1.0 - p)).mean()
 
-    return l_cut + 10.0 * l_bal + 1.0 * l_bin
+    # ---- 关键节点聚同层：按 2D slack 的相对秩给权重，惩罚关键集内 p 的离散 ----
+    slack = feats[:, 0].to(p.dtype)
+    s_min = slack.min()
+    s_max = slack.max()
+    s_norm = (slack - s_min) / (s_max - s_min + 1e-6)
+    # 越关键（slack 越小）权重越高；用 soft-rank 近似，避免硬阈值
+    crit_w = torch.sigmoid(8.0 * (0.3 - s_norm))
+    w_sum = crit_w.sum() + 1e-6
+    mu = (crit_w * p).sum() / w_sum
+    l_clust = (crit_w * (p - mu) ** 2).sum() / w_sum
+
+    # ---- 宏单元平衡：上层宏数量与宏面积占比接近 0.5（无宏时自动为 0）----
+    is_macro = graph["is_macro"].to(p.dtype)
+    n_macro = is_macro.sum()
+    macro_area = graph["area"] * is_macro
+    cnt_ratio = (is_macro * p).sum() / (n_macro + 1e-6)
+    area_ratio = (macro_area * p).sum() / (macro_area.sum() + 1e-6)
+    has_macro = (n_macro > 0.5).to(p.dtype)
+    l_macro = has_macro * (
+        torch.clamp(torch.abs(cnt_ratio - 0.5) - 0.05, min=0.0) ** 2
+        + torch.clamp(torch.abs(area_ratio - 0.5) - 0.05, min=0.0) ** 2
+    )
+
+    return l_cut + 10.0 * l_bal + 1.0 * l_bin + 20.0 * l_macro + 0.5 * l_clust
