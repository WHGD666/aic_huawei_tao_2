diff --git a/loss.py b/loss.py
--- a/loss.py
+++ b/loss.py
@@ -40,13 +40,31 @@ def compute_loss(p, graph, feats):
     sum_log_p = torch.zeros(n_nets).index_add(0, net_of_pin, log_p)
     sum_log_q = torch.zeros(n_nets).index_add(0, net_of_pin, log_q)
     cut_prob = 1.0 - torch.exp(sum_log_p) - torch.exp(sum_log_q)
+
+    # ---- 割网期望：与基线一致的乘积形式（高扇出网饱和是已知局限，
+    #      但历史显示它反而是 crit_cross 最低的骨架）----
     l_cut = cut_prob.sum() / float(n_nets)
 
-    # ---- 面积平衡：上层面积占比接近 0.5 ----
-    ratio = (area * p).sum() / area.sum()
-    l_bal = (ratio - 0.5) ** 2
+    # ---- 面积平衡：死区内静默、死区外线性铰链，避免二次项在 50% 附近太平 ----
+    total_area = torch.clamp(area.sum(), min=1e-12)
+    ratio = (area * p).sum() / total_area
+    dev = torch.abs(ratio - 0.5)
+    deadband = 0.01
+    l_bal = torch.clamp(dev - deadband, min=0.0) ** 2 + 0.05 * dev
 
     # ---- 二值化：p 远离 0.5 ----
     l_bin = (p * (1.0 - p)).mean()
 
-    return l_cut + 10.0 * l_bal + 1.0 * l_bin
+    # ---- 宏单元平衡：无宏时自动静默；数量与面积占比都拉向 0.5 ----
+    is_macro = graph["is_macro"].to(p.dtype)
+    n_macro = is_macro.sum()
+    macro_area = graph["area"] * is_macro
+    cnt_ratio = (is_macro * p).sum() / (n_macro + 1e-6)
+    area_ratio = (macro_area * p).sum() / (macro_area.sum() + 1e-6)
+    has_macro = (n_macro > 0.5).to(p.dtype)
+    l_macro = has_macro * (
+        torch.clamp(torch.abs(cnt_ratio - 0.5) - deadband, min=0.0) ** 2
+        + torch.clamp(torch.abs(area_ratio - 0.5) - deadband, min=0.0) ** 2
+    )
+
+    return l_cut + 10.0 * l_bal + 1.0 * l_bin + 4.0 * l_macro
