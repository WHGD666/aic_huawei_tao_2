+    )
+    crit_sum = torch.zeros(n_nets, dtype=p.dtype).index_add(
+        0, net_of_pin, crit[net_nodes]
+    )
+    crit_mean = crit_sum / torch.clamp(pin_cnt, min=1.0)
+    alpha = 3.0
+    w_net = 1.0 + alpha * crit_mean
