+
+    # ---- 关键度加权：网的关键度 = 其引脚关键度均值（case 内 rank 分位，单位无关）----
+    n_nodes = p.shape[0]
+    slack = feats[:, 0]
+    order = torch.argsort(torch.argsort(slack))
