diff --git a/loss.py b/loss.py
--- a/loss.py
+++ b/loss.py
@@ -40,7 +40,13 @@ def compute_loss(p, graph, feats):
     sum_log_p = torch.zeros(n_nets).index_add(0, net_of_pin, log_p)
     sum_log_q = torch.zeros(n_nets).index_add(0, net_of_pin, log_q)
     cut_prob = 1.0 - torch.exp(sum_log_p) - torch.exp(sum_log_q)
-    l_cut = cut_prob.sum() / float(n_nets)
+    # 扇出阻尼：时钟/复位/高扇出网不应主导割项梯度（尺度无关，按总权重归一）
+    pin_cnt_c = torch.zeros(n_nets).index_add(
+        0, net_of_pin, torch.ones_like(pp)
+    )
+    net_w = 1.0 / torch.log1p(torch.clamp(pin_cnt_c, min=1.0) + 1.0)
+    net_w = net_w / torch.clamp(net_w.mean(), min=1e-6)
+    l_cut = (net_w * cut_prob).sum() / float(n_nets)
 
     # ---- 面积平衡：上层面积占比接近 0.5 ----
     ratio = (area * p).sum() / area.sum()
@@ -49,4 +55,33 @@ def compute_loss(p, graph, feats):
     # ---- 二值化：p 远离 0.5 ----
     l_bin = (p * (1.0 - p)).mean()
 
-    return l_cut + 10.0 * l_bal + 1.0 * l_bin
+    # ---- 关键对局部性：star 展开 sum_pins (p_i - mean_p)^2，按关键度加权 ----
+    # 权重 = 饱和关键度 * 扇出阻尼(1/log(1+k))，再按总引脚权重归一（尺度无关）
+    n_nodes = p.shape[0]
+    slack = feats[:, 0]
+    order = torch.argsort(torch.argsort(slack))
+    rank_q = order.to(p.dtype) / max(1.0, float(n_nodes - 1))
+    crit = 1.0 - rank_q  # [0,1]，越关键越大（饱和，不平方）
+
+    pp = p[net_nodes]
+    pin_cnt = torch.zeros(n_nets).index_add(
+        0, net_of_pin, torch.ones_like(pp)
+    )
+    sum_p = torch.zeros(n_nets).index_add(0, net_of_pin, pp)
+    mean_p = sum_p / torch.clamp(pin_cnt, min=1.0)
+
+    # 关键对 Laplacian：对每个引脚，用 (p_i - mean_p_net)^2 表达"与同网其它引脚一致"，
+    # 但权重改为 crit_i * crit_net（网内平均关键度），使关键节点被拉向网内多数派。
+    # 扇出阻尼保证时钟/复位等大网不主导；按总权重归一，尺度无关。
+    net_damp = 1.0 / torch.log1p(torch.clamp(pin_cnt, min=1.0) + 1.0)
+    crit_pin = crit[net_nodes]
+    crit_sum = torch.zeros(n_nets).index_add(0, net_of_pin, crit_pin)
+    crit_net = crit_sum / torch.clamp(pin_cnt, min=1.0)
+    w_pin = net_damp[net_of_pin] * crit_pin * crit_net[net_of_pin]
+
+    dev2 = (pp - mean_p[net_of_pin]) ** 2
+
+    w_tot = torch.clamp(w_pin.sum(), min=1e-6)
+    l_loc = (w_pin * dev2).sum() / w_tot
+
+    return l_cut + 10.0 * l_bal + 1.0 * l_bin + 2.0 * l_loc
