diff --git a/loss.py b/loss.py
--- a/loss.py
+++ b/loss.py
@@ -34,13 +34,18 @@ def compute_loss(p, graph, feats):
     n_nets = graph["n_nets"]
 
     # ---- 割网期望：P(net is cut) = 1 - prod(p) - prod(1-p) ----
+    # 扇出感知加权：w_k = 1/log(1+k) 让巨大时钟/复位网不再主导割梯度
     pp = p[net_nodes]
     log_p = torch.log(torch.clamp(pp, 1e-6, 1.0))
     log_q = torch.log(torch.clamp(1.0 - pp, 1e-6, 1.0))
     sum_log_p = torch.zeros(n_nets).index_add(0, net_of_pin, log_p)
     sum_log_q = torch.zeros(n_nets).index_add(0, net_of_pin, log_q)
     cut_prob = 1.0 - torch.exp(sum_log_p) - torch.exp(sum_log_q)
-    l_cut = cut_prob.sum() / float(n_nets)
+    fanout = torch.zeros(n_nets).index_add(
+        0, net_of_pin, torch.ones_like(net_of_pin, dtype=p.dtype))
+    w_net = 1.0 / torch.log(torch.clamp(fanout, min=1.0) + 1.0)
+    w_sum = w_net.sum().clamp(min=1e-6)
+    l_cut = (w_net * cut_prob).sum() / w_sum
 
     # ---- 面积平衡：上层面积占比接近 0.5 ----
     ratio = (area * p).sum() / area.sum()
@@ -49,4 +54,20 @@ def compute_loss(p, graph, feats):
     # ---- 二值化：p 远离 0.5 ----
     l_bin = (p * (1.0 - p)).mean()
 
-    return l_cut + 10.0 * l_bal + 1.0 * l_bin
+    # ---- 关键对拉普拉斯（c032 机制，系数减半）：相邻且都关键的节点同层 ----
+    edge_index = graph["edge_index"]
+    ei = edge_index[0]
+    ej = edge_index[1]
+    slack = feats[:, 0]
+    # 案例相对的临界度：slack 越大越安全 -> 用 1 - 归一化排名作为临界度
+    s_min = slack.min()
+    s_max = slack.max()
+    s_rng = (s_max - s_min).clamp(min=1e-6)
+    slack_norm = (slack - s_min) / s_rng
+    crit = (1.0 - slack_norm).clamp(min=0.0, max=1.0)
+    w_edge = crit[ei] * crit[ej]
+    w_edge = w_edge / w_edge.mean().clamp(min=1e-6)
+    lap = (w_edge * (p[ei] - p[ej]) ** 2).mean()
+    l_crit = 0.5 * lap
+
+    return l_cut + 10.0 * l_bal + 1.0 * l_bin + l_crit
